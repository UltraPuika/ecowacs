# Copy to .env and fill in:  cp .env.example .env && nano .env
# Never commit the real .env file.

# "homeassistant" = control the real robot through Home Assistant (normal use)
# "demo"          = simulated robot, clearly marked DEMO. Nothing real is controlled.
MODE=homeassistant

# Home Assistant address as seen FROM the Raspberry Pi containers.
# If Home Assistant runs on the same Pi, use the Pi's LAN IP (not localhost), e.g. http://192.168.1.10:8123
HA_URL=http://192.168.1.10:8123

# Home Assistant long-lived access token:
# HA → your profile (bottom left) → Security → Long-lived access tokens → Create token
HA_TOKEN=

# Optional: only needed if you have more than one Ecovacs robot in Home Assistant.
# Example: vacuum.deebot_x9_pro_omni   (find it in HA → Settings → Entities)
HA_VACUUM_ENTITY=

# Password your parents type once on their phone (at least 6 characters).
APP_PASSWORD=

# Set to true ONLY if you understand that anyone on your Wi-Fi can then control the robot.
AUTH_DISABLED=false

# Optional: random string used to sign login cookies. If empty, one is generated
# and stored in the data volume. Changing APP_PASSWORD logs everyone out.
SECRET_KEY=

# Port on the Raspberry Pi where the app is served (http://<pi-ip>:8080)
APP_PORT=8080

# Set to true only if you put the app behind HTTPS (e.g. a reverse proxy with a certificate).
SECURE_COOKIES=false

# Only needed if the frontend is served from a different origin than the backend.
CORS_ORIGINS=

# Advanced timings (seconds)
COMMAND_TIMEOUT=15
VERIFY_TIMEOUT=25
DEDUPE_WINDOW=4
# Show "data may be stale" if the robot has sent nothing for this long:
STALE_AFTER=900
SESSION_DAYS=180
